{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindowsISOCatalogLinks",
  "description": "Strict JSON schema for Assistente-Aggiornamento links.json catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "win11-23h2",
    "win11-24h2",
    "win11-25h2",
    "win11-ltsc"
  ],
  "properties": {
    "win11-23h2": {
