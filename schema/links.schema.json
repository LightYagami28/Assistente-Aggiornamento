      "pattern": "^https://archive\\.org/download/[A-Za-z0-9_\\-\\.]+/it-it_windows_11_consumer_editions_version_23h2_updated_sep_2025_x64_dvd_98118d6e\\.iso$"
    },
    "win11-24h2": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://archive\\.org/download/[A-Za-z0-9_\\-\\.]+/it-it_windows_11_consumer_editions_version_24h2_updated_sep_2025_x64_dvd_6d1ad20d\\.iso$"
    },
    "win11-25h2": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://archive\\.org/download/[A-Za-z0-9_\\-\\.]+/26200\\.6584\\.250915-1905\\.25h2_ge_release_svc_refresh_CLIENT_CONSUMER_x64FRE_it-it\\.iso$"
    },
    "win11-ltsc": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://archive\\.org/download/[A-Za-z0-9_\\-\\.]+/it-it_windows_11_enterprise_ltsc_2024_x64_dvd_1e8cabb6\\.iso$"
